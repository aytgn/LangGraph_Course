# ==========================================
# Google AI Studio / Gemini API Ayarları
# Çoklu anahtar rotasyonu için virgülle ayırarak yazabilirsiniz:
# ==========================================
GOOGLE_API_KEYS="your-first-key,your-second-key,your-third-key"
GOOGLE_API_KEY="your-primary-key-here"

# ==========================================
# Google Cloud / Vertex AI (Build & Argon)
# ==========================================
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_APPLICATION_CREDENTIALS=""

# ==========================================
# LangSmith Gözlemlenebilirlik Ayarları
# https://smith.langchain.com/
# ==========================================
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="otonom-ajan-sirketi"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
